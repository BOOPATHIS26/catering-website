# Point this DNS name at the host before starting the HTTPS deployment.
DOMAIN=example.com

# Set this to the PostgreSQL connection string for deployment. Leave blank to
# use SQLite for local development.
DATABASE_URL=
CRON_SECRET=

# Copy this file to .env. Add your mail provider's SMTP details to notify the
# business when a quote enquiry arrives. Keep .env private.
FEAST_SMTP_HOST=smtp.gmail.com
FEAST_SMTP_PORT=587
FEAST_SMTP_USER=
FEAST_SMTP_PASSWORD=
FEAST_SMTP_STARTTLS=true
FEAST_SMTP_SSL=false
FEAST_NOTIFICATION_FROM=
FEAST_NOTIFICATION_TO=
